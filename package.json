{
  "name": "my-turborepo",
  "private": true,
  "packageManager": "npm@11.17.0",
  "scripts": {
    "build": "turbo run build --filter=web",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.5",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "antd": "^6.5.1",
    "clsx": "^2.1.1",
    "i18next": "^26.4.2",
    "next-intl": "^4.14.8",
    "react-i18next": "^17.0.15"
  }
}
